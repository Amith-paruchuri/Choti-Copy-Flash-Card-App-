# ─────────────────────────────────────────────────────────────
# Choti Copy — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# --- Supabase (hosted project) ---
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Needed once billing goes live (the subscription webhook
# writes profiles/subscription_events with no user session). Otherwise leave
# blank — RLS + the signed-in user's session cover every current feature.
# If set, it must only ever be read in server code.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# Which provider the AI features (condense / import summarisation / quizzes) use.
# Swappable: add a file under src/lib/ai/ implementing AIProvider, register it in
# src/lib/ai/index.ts, and set this. Supported: "gemini", "grok".
AI_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_MODEL: current fast model — gemini-3.1-flash-lite (cheapest) or
# gemini-3.6-flash. Check https://ai.google.dev/gemini-api/docs/models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# xAI / Grok API — https://console.x.ai  (optional; set AI_PROVIDER=grok to use)
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# --- App ---
# Public base URL, used to build OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Terms/Privacy version shown on the legal pages and recorded at signup.
# Bump when the policy text materially changes to re-prompt acceptance.
NEXT_PUBLIC_TERMS_VERSION=2026-09-08

# --- Billing (NOT LIVE) ---
# Payments stay off until BILLING_PROVIDER is set AND the matching keys are
# filled in. Set to "stripe" or "razorpay" only when ready to go live.
BILLING_PROVIDER=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Razorpay — https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
